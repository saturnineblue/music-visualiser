# Only needed for Online mode (generating scenes/logics with Claude).
# Offline mode never reads or sends this.
ANTHROPIC_API_KEY=
# Optional: default model for generation
CLAUDE_MODEL=claude-opus-5-5
# Optional: Blender executable for "New 3D object". Found automatically in /Applications,
# Steam and Homebrew; set this if yours lives elsewhere.
BLENDER_PATH=
